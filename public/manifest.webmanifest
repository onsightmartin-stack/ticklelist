{
  "name": "Ticklelist",
  "short_name": "Ticklelist",
  "description": "Tick your adventure — document places you've been, plan trips with friends and compete with XP and levels.",
  "id": "/community",
  "start_url": "/community",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0c10",
